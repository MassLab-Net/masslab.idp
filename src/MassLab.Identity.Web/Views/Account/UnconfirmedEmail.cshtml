@model ForgotPasswordInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Verify your email"; }
<div class="masslab-auth-card-page"><div class="masslab-auth-card"><div class="masslab-auth-card__header"><h1>Email not verified</h1><p>Please verify your email before signing in.</p></div><form asp-action="UnconfirmedEmail" method="post"><input asp-for="Email" type="hidden" /><button class="btn masslab-login__submit">Send verification email</button></form></div></div>
