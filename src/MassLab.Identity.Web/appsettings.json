{
  "Database": {
    "SeedOnStartup": false
  },
  "Multitenancy": {
    "RootDomain": "localhost",
    "AllowTenantHeaders": false
  },
  "OpenIddict": {
    "Issuer": "https://localhost:5001",
    "KeyMaterial": {
      "SigningCertificatePath": "",
      "SigningCertificatePassword": "",
      "EncryptionCertificatePath": "",
      "EncryptionCertificatePassword": ""
    },
    "Tokens": {
      "AccessTokenFormat": "EncryptedJwt"
    },
    "AdminSpaClient": {
      "ProvisionOnStartup": false,
      "RedirectUris": [
        "http://localhost:5173/auth"
      ],
      "PostLogoutRedirectUris": [
        "http://localhost:5173/logout-complete"
      ]
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "SmtpDefaults": {
    "Host": "localhost",
    "Port": 1025,
    "UseTls": false
  },
  "Security": {
    "DataProtection": {
      "KeyRingPath": "",
      "ApplicationName": "MassLab.Identity"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
