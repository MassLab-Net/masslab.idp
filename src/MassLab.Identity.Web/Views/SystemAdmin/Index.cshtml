@model IReadOnlyCollection<SystemTenantDto>
@{
    ViewData["Title"] = "Organizations";
    var createdRootEmail = TempData["CreateTenantRootEmail"] as string;
    var createdRootPassword = TempData["CreateTenantRootPassword"] as string;
    var createTenantError = TempData["CreateTenantError"] as string;
    var passwordGenerated = TempData["CreateTenantPasswordGenerated"] is bool generated && generated;
}

@if (!string.IsNullOrWhiteSpace(createTenantError))
{
    <div class="alert alert-danger">@createTenantError</div>
}

@if (!string.IsNullOrWhiteSpace(createdRootEmail) && !string.IsNullOrWhiteSpace(createdRootPassword))
{
    <div class="alert alert-success">
        <strong>Tenant created.</strong>
        Root account: <code id="created-root-email">@createdRootEmail</code>
        Password:
        <code id="created-root-password" data-password-value="@createdRootPassword" data-password-masked="true">••••••••••••</code>
        @if (passwordGenerated)
        {
            <span class="ml-2 badge badge-warning">Generated</span>
        }
        <button
            type="button"
            class="btn btn-sm btn-outline-success ml-3"
            data-copy-credentials
            data-root-email="@createdRootEmail"
            data-root-password="@createdRootPassword">
            <i class="fa fa-copy"></i>
            <span>Copy credentials</span>
        </button>
        <button
            type="button"
            class="btn btn-sm btn-outline-secondary ml-2"
            data-copy-email
            data-copy-value="@createdRootEmail">
            <i class="fa fa-envelope-o"></i>
            <span>Copy email</span>
        </button>
        <button
            type="button"
            class="btn btn-sm btn-outline-secondary ml-2"
            data-copy-password
            data-copy-value="@createdRootPassword">
            <i class="fa fa-key"></i>
            <span>Copy password</span>
        </button>
        <button
            type="button"
            class="btn btn-sm btn-outline-secondary ml-2"
            data-toggle-password
            data-password-target="created-root-password">
            <i class="fa fa-eye"></i>
            <span>Show password</span>
        </button>
    </div>
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Create Organization</h3>
    </div>
    <form asp-action="CreateTenant" method="post">
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Name</label>
                    <input name="name" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Slug</label>
                    <input name="slug" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Host name</label>
                    <input name="hostName" class="form-control" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Root email</label>
                    <input name="rootEmail" type="email" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Root display name</label>
                    <input name="rootDisplayName" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Root password</label>
                    <input name="rootPassword" type="password" class="form-control" />
                    <small class="form-text text-muted">Leave blank to auto-generate a strong password.</small>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fa fa-plus"></i> Create organization</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const registerCopyButton = (selector, getPayload, successLabel, resetLabel) => {
                const button = document.querySelector(selector);
                if (!button) {
                    return;
                }

                button.addEventListener("click", async () => {
                    const label = button.querySelector("span");

                    try {
                        await navigator.clipboard.writeText(getPayload(button));
                        if (label) {
                            label.textContent = successLabel;
                        }
                    } catch {
                        if (label) {
                            label.textContent = "Copy failed";
                        }
                    }

                    window.setTimeout(() => {
                        if (label) {
                            label.textContent = resetLabel;
                        }
                    }, 2000);
                });
            };

            registerCopyButton(
                "[data-copy-credentials]",
                (button) => `Email: ${button.getAttribute("data-root-email") ?? ""}\nPassword: ${button.getAttribute("data-root-password") ?? ""}`,
                "Copied",
                "Copy credentials");

            registerCopyButton(
                "[data-copy-email]",
                (button) => button.getAttribute("data-copy-value") ?? "",
                "Email copied",
                "Copy email");

            registerCopyButton(
                "[data-copy-password]",
                (button) => button.getAttribute("data-copy-value") ?? "",
                "Password copied",
                "Copy password");

            const toggleButton = document.querySelector("[data-toggle-password]");
            if (!toggleButton) {
                return;
            }

            toggleButton.addEventListener("click", () => {
                const targetId = toggleButton.getAttribute("data-password-target");
                const target = targetId ? document.getElementById(targetId) : null;
                const label = toggleButton.querySelector("span");
                const icon = toggleButton.querySelector("i");
                if (!target) {
                    return;
                }

                const passwordValue = target.getAttribute("data-password-value") ?? "";
                const isMasked = target.getAttribute("data-password-masked") !== "false";
                target.textContent = isMasked ? passwordValue : "••••••••••••";
                target.setAttribute("data-password-masked", isMasked ? "false" : "true");

                if (label) {
                    label.textContent = isMasked ? "Hide password" : "Show password";
                }

                if (icon) {
                    icon.className = isMasked ? "fa fa-eye-slash" : "fa fa-eye";
                }
            });
        })();
    </script>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Organizations</h3>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th>Name</th><th>Slug</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>@tenant.Name</td>
                    <td><code>@tenant.Slug</code></td>
                    <td><span class="badge @(tenant.IsActive ? "badge-success" : "badge-secondary")">@tenant.Status</span></td>
                    <td class="text-right">
                        <form asp-action="ToggleTenant" asp-route-id="@tenant.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fa fa-refresh"></i> Toggle</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
