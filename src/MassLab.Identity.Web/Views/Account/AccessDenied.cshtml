@model string
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="masslab-auth-card-page">
    <div class="masslab-auth-card masslab-auth-card--center">
        <div class="masslab-auth-card__icon masslab-auth-card__icon--danger">
            <i class="fa fa-ban"></i>
        </div>
        <div class="masslab-auth-card__header">
            <h1>Bạn không có quyền truy cập</h1>
            <p>Tài khoản hiện tại không có quyền sử dụng tính năng này.</p>
            <p>Vui lòng liên hệ quản trị viên để được cấp quyền, hoặc đăng nhập bằng một tài khoản khác.</p>
        </div>
        <form asp-action="SwitchAccount" method="post">
            <input type="hidden" name="returnUrl" value="@Model" />
            <button type="submit" class="btn masslab-login__submit">Đăng nhập bằng tài khoản khác</button>
        </form>
    </div>
</div>
